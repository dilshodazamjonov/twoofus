# Two of Us backend configuration.
# Copy to backend/.env (or run: uv run python -m app.cli.keys --init-env,
# which also generates the two secrets below). Never commit backend/.env.

# ---- General -------------------------------------------------------------
APP_NAME=Two of Us
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Browser-facing origin of the Next.js app (which proxies /api to FastAPI).
# Locally ALWAYS open the app at http://127.0.0.1:3000 (not localhost):
# cookies are per-host and Spotify only accepts 127.0.0.1 loopback callbacks.
PUBLIC_APP_URL=http://127.0.0.1:3000
# Extra origins allowed to send state-changing requests (comma separated).
EXTRA_ALLOWED_ORIGINS=

# ---- Database ------------------------------------------------------------
# Empty/unset = SQLite file at backend/data/twoofus.db (local development).
# Production: PostgreSQL, e.g. postgresql+psycopg://user:pass@host:5432/twoofus
# (plain postgres:// URLs are accepted and normalised).
# DATABASE_URL=

# ---- Secrets (REQUIRED; the app refuses to start with these placeholders) --
# SECRET_KEY: >= 32 random chars. Signs CSRF tokens.
SECRET_KEY=CHANGE_ME_generate_with_python_-m_app.cli.keys
# TOKEN_ENCRYPTION_KEYS: comma-separated url-safe base64 32-byte keys (AES-256-GCM).
# The FIRST key encrypts; older keys after it stay readable for rotation.
TOKEN_ENCRYPTION_KEYS=CHANGE_ME_generate_with_python_-m_app.cli.keys

# ---- Sessions & invitations ----------------------------------------------
# Secure cookies default to true when PUBLIC_APP_URL is https.
# COOKIE_SECURE=
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
SESSION_ROTATE_HOURS=24
INVITE_TTL_HOURS=48

# Optional: enables POST /api/v1/setup/owner exactly until an owner exists.
# Leave empty to create the owner only via: uv run python -m app.cli.bootstrap_owner
BOOTSTRAP_TOKEN=

# ---- Providers -----------------------------------------------------------
# DEMO provider: fake, clearly labelled songs; no third-party credentials.
# Convenient for local development. Set to false in production.
DEMO_MODE=true

# Spotify (official Web API, Authorization Code + PKCE, no client secret needed).
# From https://developer.spotify.com/dashboard -> your app -> Settings.
SPOTIFY_CLIENT_ID=
# Must be registered EXACTLY in the Spotify dashboard and be on PUBLIC_APP_URL's origin:
#   local:      http://127.0.0.1:3000/api/v1/providers/spotify/callback
#   production: https://<your-domain>/api/v1/providers/spotify/callback
SPOTIFY_REDIRECT_URI=

# Yandex Music (EXPERIMENTAL, unofficial yandex-music library, device-code login).
YANDEX_ENABLED=true
YANDEX_MUSIC_WEB_BASE=https://music.yandex.ru

# ---- Polling ---------------------------------------------------------------
# Per-user upstream cache TTL while the app is open (allowed 15-60).
NOW_PLAYING_TTL_SECONDS=20
PROVIDER_TIMEOUT_SECONDS=8
