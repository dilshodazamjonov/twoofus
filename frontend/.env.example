# JustTheTwoOfUs frontend. Copy to frontend/.env.local if you need to change it.
# Where the Next.js server reaches FastAPI. Used for the /api/* proxy (baked in
# at `next build`) and, at runtime, by /manifest.webmanifest to read the app
# name. The browser never sees this URL.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
# Optional: a fixed build id for the service worker (default: build time).
# APP_BUILD_ID=
# Optional, server-side only (never NEXT_PUBLIC_): must equal the backend's
# PROXY_SHARED_SECRET when that is set. The Next.js server adds it to the /api
# requests it forwards, and to its own server-side call for the manifest.
# TWOOFUS_PROXY_SECRET=
# Build-time: 1 compiles the development-only demo UI in (default for `next dev`;
# never set it for a production image).
# TWOOFUS_DEMO_UI=
