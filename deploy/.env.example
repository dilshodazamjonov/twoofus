# JustTheTwoOfUs deployment settings (NOT secrets). Copy to deploy/.env.
# Secrets live in files under TWOOFUS_SECRETS_DIR (docs/DEPLOYMENT.md, step 4).

# The public hostname people open on their phones (DNS A/AAAA record -> this server).
TWOOFUS_DOMAIN=music.example.com
# Your e-mail for Let's Encrypt certificate notices (or "internal" for a local test).
TWOOFUS_TLS=you@example.com
# Where the decrypted secret files are (the systemd unit sets /run/twoofus/secrets).
TWOOFUS_SECRETS_DIR=/run/twoofus/secrets

APP_NAME=JustTheTwoOfUs
# From https://developer.spotify.com/dashboard (no client secret: PKCE). Empty = Spotify off.
SPOTIFY_CLIENT_ID=
# Unofficial integration; set to false to switch it off.
YANDEX_ENABLED=true
LOG_LEVEL=INFO

# Image tag / service-worker build id. deploy.sh sets it to the git commit.
TWOOFUS_VERSION=local
